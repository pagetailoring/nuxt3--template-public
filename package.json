{
  "name": "nuxt3--template",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "build": "nuxi build --dotenv .env.template",
    "dev": "nuxi dev --dotenv .env.local",
    "host": "nuxi dev --dotenv .env.local --host",
    "generate": "nuxi generate --dotenv .env.template",
    "template": "nuxi generate --dotenv .env.template && scp -rp -P 41556 .output/public/. kvzbeoc@sshcloud.cluster024.hosting.ovh.net:~/_template--demo-site",
    "development": "nuxi generate --dotenv .env.development && scp -rp -P 41556 .output/public/. kvzbeoc@sshcloud.cluster024.hosting.ovh.net:~/_dev",
    "preview": "nuxi preview --dotenv .env.demo",
    "postinstall": "nuxi prepare --dotenv .env.template",
    "analyze": "nuxi analyze",
    "clean": "nuxi cleanup && rm -R node_modules",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "up": "nuxi upgrade",
    "upgrade": "nuxi upgrade"
  },
  "dependencies": {
    "@nuxt/eslint": "1.2.0",
