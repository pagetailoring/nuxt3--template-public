    "@unhead/vue": "^2.0.0-rc.8",
    "@vueuse/nuxt": "13.0.0",
    "eslint": "^9.0.0",
    "nuxt": "^3.16.0",
    "nuxt-capo": "0.2.0",
    "nuxt-payload-analyzer": "^0.1.4",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "eslint-config-prettier": "^10.1.1",
