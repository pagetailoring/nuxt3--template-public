    "nuxt": "^3.15.4",
    "vue": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.6.1",
    "@nuxtjs/html-validator": "^1.8.2",
    "nuxt-capo": "^0.2.0",
    "nuxt-payload-analyzer": "^0.1.4",
    "prettier": "^3.3.3",
    "sass": "^1.80.5",
    "typescript": "^5.6.3",
    "vue-tsc": "^2.1.8"
  }
